{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "usuario.json",
  "title": "Usuario",
  "description": "Vecino, publicador o moderador. El teléfono solo se devuelve al propio usuario y a los servicios internos.",
  "type": "object",
  "required": ["id", "nombre", "rol"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "nombre": { "type": "string", "minLength": 1 },
    "rol": { "enum": ["vecino", "publicador", "moderador"] },
    "telefono": { "type": ["string", "null"], "pattern": "^\\+[1-9][0-9]{6,14}$", "description": "E.164" },
    "whatsapp_verificado": { "type": "boolean" },
    "email": { "type": ["string", "null"], "format": "email" },
    "telegram_id": { "type": ["string", "null"], "pattern": "^-?[0-9]{1,20}$", "description": "chat_id de Telegram (contacto tg:<chat_id>). Solo para servicios internos" },
    "municipio": { "type": ["string", "null"] },
    "lat": { "type": ["number", "null"] },
    "lon": { "type": ["number", "null"] },
    "gustos": { "type": "array", "items": { "enum": ["deportiva", "cultural", "fiestas", "gastronomia", "ludica", "comercio"] } },
    "etiquetas_interes": { "type": "array", "items": { "type": "string" }, "description": "Gustos más finos: senderismo, patrimonio…" },
    "formato_aviso": { "enum": ["texto", "audio"] },
    "acepta_avisos": { "type": "boolean" },
    "radio_km": { "type": ["number", "null"], "minimum": 0 },
    "edad": { "type": ["integer", "null"], "minimum": 14, "maximum": 120, "description": "P4a. Años. Opcional. Menos de 14: 422 `edad_minima` (en España hace falta tener 14 para dar el consentimiento de datos, LOPDGDD art. 7); más de 120: 422 `validacion`. Los usuarios anteriores quedan en null" },
    "publicador_id": { "type": ["string", "null"], "format": "uuid" },
    "creado_en": { "type": "string", "format": "date-time" }
  }
}
