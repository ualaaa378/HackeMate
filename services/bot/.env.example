# Variables del servicio bot (Flujo B). Copiar a .env y rellenar.
# Benas: añadirlas también al .env.example de la raíz cuando exista.

API_URL=http://api:8000
INTERNAL_TOKEN=cambia-esto

# Telegram (gratis, sin límites). Token de @BotFather. Con token, Telegram queda activo
# a la vez que el canal de WhatsApp de abajo
TELEGRAM_TOKEN=
# Texto aleatorio que Telegram nos devuelve en cada webhook para saber que es él
TELEGRAM_SECRET=

# Canal de WhatsApp: meta = WhatsApp Cloud API (producción) · twilio = alternativa · console = solo imprime
CANAL=console

# WhatsApp Cloud API (Meta). Todo sale de developers.facebook.com > tu app > WhatsApp
# Token permanente de un usuario del sistema (no el temporal de 24 h)
META_TOKEN=
# «Phone number ID» en WhatsApp > Configuración de la API
META_PHONE_NUMBER_ID=
# Configuración de la app > Básica > Clave secreta. Obligatorio en producción (firma del webhook)
META_APP_SECRET=
# Texto que inventamos y pegamos también en la configuración del webhook
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
META_IDIOMA_PLANTILLAS=es

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VALIDAR_FIRMA=false

# Orden de proveedores de IA; "reglas" es el último recurso sin IA.
# Un proveedor sin clave se salta solo. Claude es de pago: déjalo vacío si no hay créditos.
LLM_CADENA=gemini,freellm,claude,reglas
LLM_TIMEOUT_S=25
LLM_SIMULAR_CAIDA=false

# Gemini (gratis): clave de https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# FreeLLMAPI (gratis, se ejecuta en local). Desde Docker: http://host.docker.internal:31415/v1
FREELLM_URL=http://127.0.0.1:31415/v1
FREELLM_API_KEY=
# Modelos en orden (ids de GET /v1/models del proxy) y espera máxima por intento
FREELLM_MODELOS=qwen3.8-27b,gemini-flash-lite,auto
FREELLM_TIMEOUT_INTENTO_S=8

# Claude (de pago, opcional)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
