# Variables del contenedor de FreeLLMAPI. Copiar a .env (no se sube a git) y rellenar.

# Obligatoria: cifra las claves de los proveedores en la base de datos. 64 caracteres hexadecimales.
# Genérala una vez y no la cambies (si cambia, las claves guardadas ya no se pueden descifrar):
#   python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# Puerto en esta máquina (dentro del contenedor siempre es 3001)
PORT=3001

# 127.0.0.1 = solo esta máquina (recomendado). 0.0.0.0 = también la red local (solo en una red de confianza)
HOST_BIND=127.0.0.1
