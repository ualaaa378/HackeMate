# Variables de TODOS los servicios. Copiar a .env (nunca se sube) y rellenar.
# Las claves se pasan por mensaje privado.

# ---------- Comunes ----------
ZONA_HORARIA=Europe/Madrid
# Token compartido entre api y bot (cabecera X-Internal-Token). Cambiarlo en la demo.
INTERNAL_TOKEN=cambia-esto

# ---------- Base de datos (db) ----------
POSTGRES_USER=hackemate
POSTGRES_PASSWORD=hackemate
POSTGRES_DB=hackemate
DB_PORT=5432

# ---------- api (Flujo A) ----------
# Docker: postgresql+psycopg://hackemate:hackemate@db:5432/hackemate
# Windows sin Docker: sqlite:///./hackemate.db  o la URL de Neon/Supabase
DATABASE_URL=sqlite:///./hackemate.db
API_URL=http://api:8000
# Versión que devuelve /health (vacío = la del código)
APP_VERSION=
BOT_URL=http://bot:8001
JWT_SECRET=cambia-esto-tambien
JWT_EXPIRA_MIN=1440
# Google OAuth (login con Google): ID de cliente web de Google Cloud
GOOGLE_CLIENT_ID=
# Aprobaciones necesarias para subir de nivel de confianza a un publicador
MODERACION_APROBACIONES_SUBIR_NIVEL=3
# Umbral de score_spam (0-1) a partir del cual un evento va a revisión
MODERACION_UMBRAL_SPAM=0.7
# Orígenes permitidos por CORS (separados por comas)
CORS_ORIGENES=http://localhost:8080,http://localhost:5173,http://localhost:8100
# Carpeta de los fixtures que carga scripts/seed.py (vacío = contracts/fixtures del repo)
FIXTURES_DIR=

# ---------- bot (Flujo B) ----------
# Detalle en services/bot/.env.example y docs/PLAN_FLUJO_B.md
# Telegram (canal activo: gratis y sin límites). Token de @BotFather; los destinos «tg:<chat_id>» van por aquí
TELEGRAM_TOKEN=
# Texto aleatorio para la cabecera X-Telegram-Bot-Api-Secret-Token del webhook
TELEGRAM_SECRET=
# Canal de WhatsApp: meta (Cloud API, producción) · twilio (alternativa) · console (solo imprime)
CANAL=console
# WhatsApp Cloud API (Meta). Bloqueado en la hackathon: Meta pide verificar el negocio y método de pago
META_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
META_IDIOMA_PLANTILLAS=es
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VALIDAR_FIRMA=false
# Proveedores de IA en orden; "reglas" es el último recurso sin IA
LLM_CADENA=gemini,freellm,claude,reglas
LLM_TIMEOUT_S=25
LLM_SIMULAR_CAIDA=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Desde Docker: http://host.docker.internal:31415/v1
FREELLM_URL=http://127.0.0.1:31415/v1
FREELLM_API_KEY=
FREELLM_MODELOS=qwen3.8-27b,gemini-flash-lite,auto
FREELLM_TIMEOUT_INTENTO_S=8
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# Transcripción de audio (Whisper vía API, opcional)
OPENAI_API_KEY=

# ---------- web (Flujo C) ----------
VITE_API_URL=http://localhost:8000
# false = la app lee la API real (y vuelve a los mocks si falla). true = solo mocks.
VITE_USE_MOCKS=false
VITE_GOOGLE_CLIENT_ID=

# ---------- tunnel ----------
# Vacío = túnel rápido (la URL cambia al reiniciar). Con token = túnel con nombre estable.
CLOUDFLARE_TUNNEL_TOKEN=
