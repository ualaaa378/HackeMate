# Variables de TODOS los servicios. Copiar a .env (nunca se sube) y rellenar.
# Las claves se pasan por mensaje privado.

# ---------- Comunes ----------
ZONA_HORARIA=Europe/Madrid
# Token compartido entre api y bot (cabecera X-Internal-Token). Cambiarlo en la demo.
INTERNAL_TOKEN=cambia-esto

# ---------- Base de datos (db) ----------
POSTGRES_USER=hackemate
POSTGRES_PASSWORD=hackemate
POSTGRES_DB=hackemate
DB_PORT=5432

# ---------- api (Flujo A) ----------
# Docker: postgresql+psycopg://hackemate:hackemate@db:5432/hackemate
# Windows sin Docker: sqlite:///./hackemate.db  o la URL de Neon/Supabase
DATABASE_URL=sqlite:///./hackemate.db
API_URL=http://api:8000
# Versión que devuelve /health (vacío = la del código)
APP_VERSION=
BOT_URL=http://bot:8001
# Firma de las sesiones (JWT HS256) y su duración en minutos. Cambiar el secreto en la demo.
JWT_SECRET=cambia-esto-tambien
JWT_EXPIRA_MIN=1440
# Google OAuth (login con Google): ID de cliente web de Google Cloud. Vacío = POST /auth/google responde 503
GOOGLE_CLIENT_ID=
GOOGLE_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo
GOOGLE_TIMEOUT_S=5
# Modo demo: true habilita POST /api/v1/auth/demo (sesión como cualquier usuario o rol, sin login).
# Solo para la presentación al jurado; con false (por defecto) la ruta responde 404.
DEMO_MODE=false
# Ya no se usa: solo hay dos modos de publicación (a mano y automática) y no hay subida automática de nivel.
# Se conserva para no romper .env antiguos.
MODERACION_APROBACIONES_SUBIR_NIVEL=3
# Umbral de score_spam (0-1) a partir del cual un evento va a revisión
MODERACION_UMBRAL_SPAM=0.7
# D4: lo importado solo (Facebook de los ayuntamientos, importado_auto) pasa siempre por la bandeja del moderador,
# aunque la asociación esté en automática. false = se publica solo si la asociación está en automática
MODERACION_IMPORTADOS_A_BANDEJA=true
# Cola de avisos: espera máxima a POST {BOT_URL}/notify (s) e intentos antes de dar un aviso por fallido
NOTIFICACIONES_TIMEOUT_S=3
NOTIFICACIONES_MAX_INTENTOS=5
# Cada cuántos segundos la API reintenta los avisos pendientes en segundo plano (0 = desactivado)
NOTIFICACIONES_REINTENTO_S=60
# Coste de la IA en /estadisticas: euros por millón de tokens (entrada/salida) por "proveedor" o "proveedor:modelo".
# Lo que no aparece cuenta como gratuito (0 €). Ajustar "claude" a la tarifa vigente del modelo usado.
PRECIOS_TOKENS_EUR_MTOK={"gemini":{"entrada":0,"salida":0},"freellm":{"entrada":0,"salida":0},"reglas":{"entrada":0,"salida":0},"claude":{"entrada":5,"salida":25}}
# Orígenes permitidos por CORS (separados por comas). La web pública no lo necesita: llama a la API en su
# mismo dominio a través del nginx de la web. El APK de Capacitor sí: https://localhost (Android) y
# capacitor://localhost (iOS).
CORS_ORIGENES=http://localhost:8080,http://localhost:5173,http://localhost:8100,https://localhost,capacitor://localhost
# Carpeta de los fixtures que carga scripts/seed.py (vacío = contracts/fixtures del repo)
FIXTURES_DIR=

# ---------- ingesta de Facebook (scripts/importar_facebook.py, flujo A) ----------
# Token de Apify para «Facebook Posts Scraper» (plan gratuito). Vacío = solo funciona --desde-json
FB_SCRAPER_TOKEN=
FB_SCRAPER_ACTOR=apify~facebook-posts-scraper
# Páginas extra separadas por comas (además de las fuentes de Facebook dadas de alta en la API).
# Las 4 con actividad en 2026 (contracts/fixtures/FUENTES.md): Aytos. de Uleila del Campo, Lucainena y Senés, y Monte-Sión
FB_PAGINAS=https://www.facebook.com/profile.php?id=100064568389094,https://www.facebook.com/profile.php?id=100064636603636,https://www.facebook.com/profile.php?id=61551352857893,https://www.facebook.com/MonteSionLucainenaDeLasTorres
# Posts por página y antigüedad máxima (formato de Apify: «30 days», «2026-11-01»…)
FB_MAX_POSTS=10
FB_DESDE=30 days

# ---------- bot (Flujo B) ----------
# Detalle en services/bot/.env.example y docs/PLAN_FLUJO_B.md
# Telegram (canal activo: gratis y sin límites). Token de @BotFather; los destinos «tg:<chat_id>» van por aquí
TELEGRAM_TOKEN=
# Texto aleatorio para la cabecera X-Telegram-Bot-Api-Secret-Token del webhook
TELEGRAM_SECRET=
# URL pública del túnel: si está, el bot registra el webhook de Telegram AL ARRANCAR.
# El token de Telegram es uno para todo el equipo y solo un bot recibe los mensajes a la vez:
# déjalo vacío salvo en la máquina que hace la demo (si no, le quitas el webhook al compañero).
PUBLIC_URL=
# Cola del bot cuando la api está caída (en Docker conviene un volumen para que sobreviva)
COLA_PATH=data/cola_pendiente.json
COLA_REINTENTO_S=30
# Canal de WhatsApp: meta (Cloud API, producción) · twilio (alternativa) · console (solo imprime)
CANAL=console
# WhatsApp Cloud API (Meta). Bloqueado en la hackathon: Meta pide verificar el negocio y método de pago
META_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
META_IDIOMA_PLANTILLAS=es
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VALIDAR_FIRMA=false
# Proveedores de IA en orden; "reglas" es el último recurso sin IA
LLM_CADENA=gemini,nim,freellm,claude,reglas
LLM_TIMEOUT_S=25
LLM_SIMULAR_CAIDA=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# NVIDIA NIM (build.nvidia.com, plan gratuito con clave propia), directo y sin pasar por FreeLLMAPI.
# Va antes que FreeLLM en LLM_CADENA: si el proxy o el portátil donde corre fallan, la IA sigue. Vacío = se salta
NIM_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=
# Se prueban en orden. nemotron-3.5-bolt-e4b: 1-3 s con el plan gratuito (los grandes pasaban de 25 s)
NIM_MODELOS=nvidia/nemotron-3.5-bolt-e4b
NIM_TIMEOUT_INTENTO_S=10
# Sin Docker: 127.0.0.1. En Docker el compose la fija a http://host.docker.internal:31415/v1
FREELLM_URL=http://127.0.0.1:31415/v1
# Misma URL vista desde el contenedor del bot en docker compose
FREELLM_URL_DOCKER=http://host.docker.internal:31415/v1
FREELLM_API_KEY=
FREELLM_MODELOS=qwen3.8-27b,gemini-flash-lite,auto
FREELLM_TIMEOUT_INTENTO_S=8
# Carteles (modelos con visión, en orden) y notas de voz (transcripción del proxy)
FREELLM_MODELOS_VISION=gemini-flash-lite,auto
FREELLM_MODELO_AUDIO=whisper-large-v3
MEDIOS_TIMEOUT_S=30
# Respuestas en nota de voz (TTS del proxy) para quien escribe con audios o pide avisos por voz
FREELLM_MODELO_VOZ=auto
FREELLM_VOZ=alloy
# Enlaces a la ficha en la web/PWA del flujo C ({WEB_URL}/evento/{id}). En la demo, la URL del túnel
# (la misma que PUBLIC_URL: el túnel entra por la web). La actualiza el script de F1.
WEB_URL=http://localhost:8080
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# Transcripción de audio (Whisper vía API, opcional)
OPENAI_API_KEY=

# ---------- web (Flujo C) ----------
# Dónde llama la web a la API (se incrusta en el build). «/» = en su mismo dominio, a través del
# nginx de la web (web:8080 pasa /api/ a api:8000): vale igual en localhost:8080 que en la URL del túnel.
# Vacío = solo mocks. Para `npm run dev` fuera de Docker, en apps/web/.env.local: http://localhost:8000
VITE_API_URL=/
# false = la app lee la API real (y vuelve a los mocks si falla). true = solo mocks.
VITE_USE_MOCKS=false
# Canal que la web nombra al vecino (alta y avisos): telegram (activo) o whatsapp. Debe coincidir con el del bot
VITE_CANAL=telegram
# Contacto del bot que enseña Perfil (@usuario de Telegram o número de WhatsApp). Vacío = @HackeMate_bot con Telegram
VITE_CANAL_CONTACTO=
VITE_GOOGLE_CLIENT_ID=

# ---------- tunnel ----------
# Vacío = túnel rápido (la URL cambia al reiniciar). Con token = túnel con nombre estable.
CLOUDFLARE_TUNNEL_TOKEN=
